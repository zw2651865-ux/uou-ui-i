@echo off
setlocal DisableDelayedExpansion
chcp 65001 >nul
set "PD_BUILD_BAT=%~f0"
echo ==========================================================
echo PromptDesk - Single EXE Builder (embedded cat icon)
echo Put promptdesk.pyw beside this BAT, then double-click.
echo Original source and existing PromptDesk data are preserved.
echo Internet is required to install audited build dependencies.
echo ==========================================================
where py >nul 2>nul
if errorlevel 1 goto try_python
py -3 -I -c "import os,base64;from pathlib import Path;s=Path(os.environ['PD_BUILD_BAT']).read_text(encoding='utf-8');b=s.split('\n#==PROMPTDESK_BUILD_PAYLOAD==\n',1)[1];exec(compile(base64.b64decode(b),'PromptDesk_build','exec'),{'__name__':'__main__'})"
goto finished
:try_python
where python >nul 2>nul
if errorlevel 1 goto no_python
python -I -c "import os,base64;from pathlib import Path;s=Path(os.environ['PD_BUILD_BAT']).read_text(encoding='utf-8');b=s.split('\n#==PROMPTDESK_BUILD_PAYLOAD==\n',1)[1];exec(compile(base64.b64decode(b),'PromptDesk_build','exec'),{'__name__':'__main__'})"
goto finished
:no_python
echo ERROR: Python not found. Install 64-bit Python 3.12, then retry.
set "PD_RC=1"
goto pause_and_exit
:finished
set "PD_RC=%ERRORLEVEL%"
if not "%PD_RC%"=="0" echo BUILD FAILED. Read the error above and the build log if created.
if "%PD_RC%"=="0" echo DONE. Your standalone application is PromptDesk.exe beside this BAT.
:pause_and_exit
echo.
pause
exit /b %PD_RC%
#==PROMPTDESK_BUILD_PAYLOAD==

